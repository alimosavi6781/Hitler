<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F5F7FB">

    <ImageView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_logo"
        android:contentDescription="Parilo Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parilo"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اینترنت آزاد، سریع و امن"
        android:textSize="14sp"
        android:textColor="#607D8B"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="28dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○ قطع - آماده اتصال"
        android:textSize="14sp"
        android:textColor="#616161"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="کلید را وارد کن ss://..."
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="13sp"
            android:hint="ss://Y2hhY2hhMj...@IP:PORT" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="کلید را از سرور Outline خود کپی کن"
        android:textSize="11sp"
        android:textColor="#90A4AE"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="اتصال"
        android:textSize="16sp"
        app:cornerRadius="14dp"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDisconnect"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="قطع اتصال"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:cornerRadius="14dp"
        app:strokeColor="#B0BEC5" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parilo v1.0 • ساخته شده برای اندروید"
        android:textSize="10sp"
        android:textColor="#B0BEC5"
        android:layout_marginTop="28dp" />

</LinearLayout>
