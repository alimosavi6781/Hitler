[Unit]
Description=Persian Telegram Crypto Alert Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/crypto-alert-bot
EnvironmentFile=/opt/crypto-alert-bot/.env
ExecStart=/usr/bin/python3 /opt/crypto-alert-bot/bot.py
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/crypto-alert-bot/data

[Install]
WantedBy=multi-user.target
