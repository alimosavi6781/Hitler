# توکن قبلی را چون در گفتگو فرستاده‌ای، ابتدا در BotFather با /revoke عوض کن.
BOT_TOKEN=PASTE_YOUR_NEW_BOT_TOKEN_HERE

# تنظیمات پیشنهادی
DATABASE_PATH=data/bot.db
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT
CHECK_INTERVAL=60
POLL_TIMEOUT=50
HTTP_TIMEOUT=15
LOG_LEVEL=INFO

# برای سرویس‌های میزبانی وب؛ در اجرای محلی هم مشکلی ایجاد نمی‌کند.
PORT=8000

# حالت شخصی قدیمی: شناسه چت‌های مجاز را با ویرگول جدا کن.
# در حالت فروش اشتراکی، ADMIN_USER_IDS جایگزین این محدودیت می‌شود.
ALLOWED_CHAT_IDS=

# فروش اشتراک دستی (پیش‌فرض خاموش است)
# بعد از تست، مقدار را true و شناسه خودت را در ADMIN_USER_IDS وارد کن.
SUBSCRIPTION_MODE=false
ADMIN_USER_IDS=

# اختیاری: نام کاربری تلگرام فروشنده بدون علامت @
SUPPORT_USERNAME=
