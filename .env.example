# توکن قبلی را چون در گفتگو فرستاده‌ای، ابتدا در BotFather با /revoke عوض کن.
BOT_TOKEN=PASTE_YOUR_NEW_BOT_TOKEN_HERE

# تنظیمات پیشنهادی
DATABASE_PATH=data/bot.db
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT
CHECK_INTERVAL=60
POLL_TIMEOUT=50
HTTP_TIMEOUT=15
LOG_LEVEL=INFO

# برای سرویس‌های میزبانی وب؛ در اجرای محلی هم مشکلی ایجاد نمی‌کند.
PORT=8000

# اختیاری: پس از اجرای /id، شناسه چت خودت را اینجا بگذار تا ربات خصوصی شود.
# چند شناسه را با ویرگول جدا کن. خالی یعنی همه می‌توانند استفاده کنند.
ALLOWED_CHAT_IDS=
